
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix am: <https://w3id.org/airmove-madrid/ontology/AirMove#> .

<#StationMapping>
    rml:logicalSource [
        rml:source "csv/estaciones-control-updated.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "https://w3id.org/airmove-madrid/resource/station/{CODIGO_CORTO}" ;
        rr:class am:AirQualityStation
    ] ;

    rr:predicateObjectMap [
        rr:predicate am:hasName ;
        rr:objectMap [ rml:reference "ESTACION" ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate am:stationCode ;
        rr:objectMap [
            rml:reference "CODIGO_CORTO" ;
            rr:datatype xsd:integer
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate am:latitude ;
        rr:objectMap [
            rml:reference "LATITUD" ;
            rr:datatype xsd:decimal
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate am:longitude ;
        rr:objectMap [
            rml:reference "LONGITUD" ;
            rr:datatype xsd:decimal
        ]
    ] .
